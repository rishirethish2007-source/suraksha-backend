DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/suraksha_sos
# Generate your own secret, e.g. python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET_KEY=
JWT_ISSUER=suraksha
JWT_AUDIENCE=suraksha-api
CORS_ORIGINS=["http://localhost:8081"]
AUTO_CREATE_TABLES=false

JWT_ALGORITHM=HS256
# Production OIDC: configure the issuer's PEM public key and matching algorithm/audience.
JWT_PUBLIC_KEY=
# PEM P-256 private key. scripts/dev_setup.py generates one for local tests.
DEVICE_CA_PRIVATE_KEY=
DEVICE_CERT_DAYS=30
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
